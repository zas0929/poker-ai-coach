# Local development uses SQLite when POKER_DATABASE_URL is unset.
# Hosted backend secret only: use Supabase Session pooler IPv4, port 5432.
# POKER_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER:5432/postgres?sslmode=require
# Exact frontend origins, comma-separated. Never use a wildcard.
POKER_ROOM_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bounded river models; the Docker image includes the verified native kernel.
# Explicit opt-in; other streets and live coach advice are unchanged.
# POKER_RIVER_LESSONS_ENABLED=1
# Local development alias remains supported: POKER_LOCAL_RIVER_LESSONS=1

# Current training river model shares the river-lessons queue when enabled.
# Set 0 to disable only this panel; no new service or API key is needed.
# POKER_TRAINER_SOLVER_ENABLED=0
